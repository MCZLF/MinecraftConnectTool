<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftConnectTool.ViewModels.RightPage"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="MinecraftConnectTool.Views.RightPage.PanelAlert"
             x:DataType="vm:PanelAlertViewModel"
             Width="350">
  <UserControl.Styles>
    <Style Selector="Button.back-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.back-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceVariantBrush}"/>
    </Style>
    <Style Selector="Button.action-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.action-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceVariantBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" MinHeight="56" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0">
      <Button Grid.Column="0"
              x:Name="BackButton"
              Classes="back-button"
              VerticalAlignment="Center"
              Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <icons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          <TextBlock Text="Back" FontSize="14" Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
        </StackPanel>
      </Button>

      <Grid Grid.Column="1"
            x:Name="TitleArea"
            ColumnDefinitions="Auto,Auto"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Margin="8,0,6,0"
            Cursor="Hand">
        <icons:MaterialIcon Grid.Column="0"
                            Kind="NotificationsActive" 
                            Width="18" 
                            Height="18"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource MaterialPrimaryBrush}"/>
        <StackPanel Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="2">
          <TextBlock Text="重要云公告"
                     FontSize="14"
                     FontWeight="Medium"
                     HorizontalAlignment="Center"
                     TextTrimming="CharacterEllipsis"
                     Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          <TextBlock x:Name="TagIdText"
                     Text="TagID:"
                     FontSize="11"
                     FontWeight="Medium"
                     IsVisible="False"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialPrimaryBrush}"/>
        </StackPanel>
      </Grid>

      <Button Grid.Column="2"
              x:Name="UrlButton"
              Classes="action-button"
              IsVisible="False"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="0,0,4,0">
        <icons:MaterialIcon Kind="Link" 
                            Width="20" 
                            Height="20"
                            Foreground="{DynamicResource MaterialPrimaryBrush}"/>
      </Button>

      <Button Grid.Column="3"
              x:Name="RefreshButton"
              Classes="action-button"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="0,0,8,0">
        <icons:MaterialIcon Kind="Refresh" 
                            Width="20" 
                            Height="20"
                            Foreground="{DynamicResource MaterialPrimaryBrush}"/>
      </Button>
    </Grid>

    <Border Grid.Row="1" 
            Background="{DynamicResource MaterialSurfaceVariantBrush}"
            Margin="12,0,12,12"
            CornerRadius="8"
            Padding="16">
      <ScrollViewer>
        <TextBlock x:Name="AlertContent"
                   Text="正在加载公告..."
                   FontSize="13"
                   TextWrapping="Wrap"
                   LineHeight="24"
                   Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
