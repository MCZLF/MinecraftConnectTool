<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftConnectTool.ViewModels.Pages"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="MinecraftConnectTool.Views.Pages.HelpPage"
             x:DataType="vm:HelpPageViewModel">
  <ScrollViewer>
    <StackPanel Margin="24" Spacing="16">
      <!-- 标题 -->
      <TextBlock Text="{Binding UserName, StringFormat='Hi, {0}'}"
                 FontSize="32"
                 FontWeight="Light"
                 Foreground="{DynamicResource MaterialOnBackgroundBrush}"/>

      <TextBlock Text="需要帮助吗,以下是一些教程,可以提前看看&#x0A;看完后可以点击左侧菜单,即可返回主界面~"
                 FontSize="16"
                 TextWrapping="Wrap"
                 Opacity="0.8"
                 Foreground="{DynamicResource MaterialOnBackgroundBrush}"/>

      <!-- 教程链接卡片 -->
      <Grid ColumnDefinitions="*,*,*" Margin="0,16,0,0">
        <!-- 图文教程 -->
        <Border Grid.Column="0"
                Background="{DynamicResource MaterialCardVariantBrush}"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,4,0"
                PointerPressed="OnTutorialLinkClick">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="BookOpenPageVariant" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialPrimaryBrush}"/>
              <TextBlock Text="图文教程"
                         FontSize="14"
                         FontWeight="Medium"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
            </StackPanel>
            <TextBlock Text="https://mct.loft.games/tutorial"
                       FontSize="12"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          </StackPanel>
        </Border>

        <!-- 视频教程 -->
        <Border Grid.Column="1"
                Background="{DynamicResource MaterialCardVariantBrush}"
                CornerRadius="12"
                Padding="16"
                Margin="4,0,4,0"
                PointerPressed="OnVideoLinkClick">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="PlayCircle" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialErrorBrush}"/>
              <TextBlock Text="视频教程"
                         FontSize="14"
                         FontWeight="Medium"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
            </StackPanel>
            <TextBlock Text="https://www.bilibili.com/video/BV1DdK66UECG"
                       FontSize="12"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          </StackPanel>
        </Border>

        <!-- 官方网站 -->
        <Border Grid.Column="2"
                Background="{DynamicResource MaterialCardVariantBrush}"
                CornerRadius="12"
                Padding="16"
                Margin="4,0,0,0"
                PointerPressed="OnWebsiteLinkClick">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <icons:MaterialIcon Kind="Web" Width="20" Height="20" VerticalAlignment="Center" Foreground="{DynamicResource MaterialSecondaryBrush}"/>
              <TextBlock Text="官方网站"
                         FontSize="14"
                         FontWeight="Medium"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
            </StackPanel>
            <TextBlock Text="https://mct.loft.games/"
                       FontSize="12"
                       Opacity="0.7"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- 提示信息 -->
      <Border Background="{DynamicResource MaterialCardVariantBrush}"
              CornerRadius="8"
              Padding="16">
        <StackPanel Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <icons:MaterialIcon Kind="Information" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MaterialPrimaryBrush}"/>
            <TextBlock Text="点击上方链接即可直接打开~"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- QQ群 -->
      <Border Background="{DynamicResource MaterialCardVariantBrush}"
              CornerRadius="8"
              Padding="16"
              PointerPressed="OnQQGroupLinkClick"
              Cursor="Hand">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <icons:MaterialIcon Kind="AccountGroup" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource MaterialPrimaryBrush}"/>
          <TextBlock Text="欢迎加入QQ群一起讨论"
                     FontSize="13"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          <TextBlock Text="690625244"
                     FontSize="13"
                     FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource MaterialPrimaryBrush}"/>
        </StackPanel>
      </Border>

      <!-- 功能按钮 -->
      <Grid ColumnDefinitions="*,*,*,*" Margin="0,16,0,0">
        <Button Grid.Column="0"
                Margin="0,0,8,0"
                HorizontalAlignment="Stretch"
                Click="OnImageGuideClick">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Github" Width="18" Height="18"/>
            <TextBlock Text="Github" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="1"
                Margin="4,0,4,0"
                HorizontalAlignment="Stretch"
                Click="OnBugReportClick">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="BugReport" Width="18" Height="18"/>
            <TextBlock Text="BUG反馈" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="2"
                Margin="4,0,4,0"
                HorizontalAlignment="Stretch"
                Click="OnForceKillCoreClick">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon Kind="Power" Width="18" Height="18"/>
            <TextBlock Text="强制终止核心" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Grid.Column="3"
                x:Name="RemoteControlButton"
                Margin="8,0,0,0"
                HorizontalAlignment="Stretch"
                Click="OnRemoteControlClick">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
            <icons:MaterialIcon x:Name="RemoteControlButtonIcon" Kind="PlayCircle" Width="18" Height="18"/>
            <TextBlock x:Name="RemoteControlButtonText" Text="启动远程控制" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border x:Name="RemoteControlDownloadBorder"
              Background="{DynamicResource MaterialPrimaryContainerBrush}"
              CornerRadius="12"
              Padding="16"
              IsVisible="False">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock x:Name="RemoteControlDownloadText"
                       Grid.Column="0"
                       Text="正在下载远程控制组件..."
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
            <TextBlock x:Name="RemoteControlDownloadPercentText"
                       Grid.Column="1"
                       Text="0%"
                       FontSize="14"
                       FontWeight="Medium"
                       Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
          </Grid>
          <ProgressBar x:Name="RemoteControlDownloadProgressBar"
                       Minimum="0"
                       Maximum="100"
                       Value="0"
                       Height="6"/>
        </StackPanel>
      </Border>

      <!-- 渲染模式显示区域 -->
      <Border x:Name="RenderingModeBorder"
              Background="{DynamicResource MaterialPrimaryContainerBrush}"
              CornerRadius="12"
              Padding="16"
              IsVisible="False">
        <StackPanel Spacing="8">
          <TextBlock x:Name="RenderingModeText"
                     FontSize="16"
                     FontWeight="Medium"
                     Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          <TextBlock x:Name="RenderingModeDetail"
                     FontSize="13"
                     Opacity="0.8"
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
        </StackPanel>
      </Border>

      <!-- Restart 按钮 - 右下角 -->
      <Button Content="Restart"
              HorizontalAlignment="Right"
              VerticalAlignment="Bottom"
              Margin="0,32,0,0"
              Click="OnRestartClick"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
