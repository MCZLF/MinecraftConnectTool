<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftConnectTool.ViewModels.RightPage"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="MinecraftConnectTool.Views.RightPage.ETRoomList"
             x:DataType="vm:ETRoomListViewModel"
             Width="380">
  <UserControl.Styles>
    <Style Selector="Button.back-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.back-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceVariantBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- 顶部标题栏 -->
    <Grid Grid.Row="0" Height="48" ColumnDefinitions="Auto,*,Auto" Margin="0">
      <!-- Back按钮 -->
      <Button Grid.Column="0"
              x:Name="BackButton"
              Classes="back-button"
              VerticalAlignment="Center"
              Margin="8,0,0,0"
              Command="{Binding CloseCommand}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <icons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          <TextBlock Text="Back" FontSize="14" Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
        </StackPanel>
      </Button>

      <!-- 标题 -->
      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center"
                  Margin="12,0,0,0">
        <icons:MaterialIcon Kind="AccountGroup"
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource MaterialPrimaryBrush}"/>
        <TextBlock Text="{Binding PanelTitle}"
                   FontSize="14"
                   VerticalAlignment="Center"
                   FontWeight="Medium"
                   Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
        <Border Background="{DynamicResource MaterialPrimaryContainerBrush}"
                CornerRadius="10"
                Padding="6,2"
                VerticalAlignment="Center">
          <TextBlock Text="{Binding PlayerCountText}"
                     FontSize="11"
                     FontWeight="Medium"
                     Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
        </Border>
      </StackPanel>

      <!-- 刷新按钮 -->
      <Button Grid.Column="2"
              x:Name="RefreshButton"
              Classes="back-button"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="0,0,8,0"
              Command="{Binding RefreshCommand}">
        <icons:MaterialIcon Kind="Refresh"
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource MaterialPrimaryBrush}"/>
      </Button>
    </Grid>

    <!-- 内容区域 -->
    <Grid Grid.Row="1" Margin="12,0,12,12">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- 房间信息 -->
      <Border Grid.Row="0"
              Background="{DynamicResource MaterialPrimaryContainerBrush}"
              CornerRadius="8"
              Padding="12"
              Margin="0,0,0,12">
        <StackPanel Orientation="Horizontal" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <icons:MaterialIcon Kind="Key"
                                Width="14"
                                Height="14"
                                Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
            <TextBlock Text="{Binding RoomCodeText}"
                       FontSize="12"
                       Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
          </StackPanel>
          <TextBlock Text="{Binding StatusText}"
                     FontSize="12"
                     Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
        </StackPanel>
      </Border>

      <!-- 玩家列表 -->
      <Border Grid.Row="1"
              Background="{DynamicResource MaterialCardVariantBrush}"
              CornerRadius="8"
              Padding="0">
        <Grid>
          <!-- 空状态 -->
          <StackPanel HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Spacing="8"
                      IsVisible="{Binding IsEmpty}">
            <icons:MaterialIcon Kind="AccountOff"
                                Width="48"
                                Height="48"
                                Opacity="0.5"
                                Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"/>
            <TextBlock Text="暂无其他玩家"
                       FontSize="14"
                       Opacity="0.7"
                       Foreground="{DynamicResource MaterialOnSurfaceVariantBrush}"/>
          </StackPanel>

          <!-- 玩家列表 -->
          <ScrollViewer IsVisible="{Binding !IsEmpty}"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Players}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource MaterialCardBrush}"
                          CornerRadius="8"
                          Padding="12"
                          Margin="8,4,8,4">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <!-- 头像 -->
                      <Border Grid.Column="0"
                              Width="36"
                              Height="36"
                              CornerRadius="18"
                              Background="{DynamicResource MaterialPrimaryContainerBrush}"
                              VerticalAlignment="Center">
                        <TextBlock Text="{Binding Initial}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
                      </Border>

                      <!-- 信息 -->
                      <StackPanel Grid.Column="1"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding DisplayName}"
                                   FontSize="14"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
                      </StackPanel>

                      <!-- 房主标签 -->
                      <Border Grid.Column="2"
                              IsVisible="{Binding IsHost}"
                              Background="{DynamicResource MaterialPrimaryContainerBrush}"
                              CornerRadius="4"
                              Padding="6,2"
                              VerticalAlignment="Center">
                        <TextBlock Text="房主"
                                   FontSize="10"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource MaterialOnPrimaryContainerBrush}"/>
                      </Border>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</UserControl>
