<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MinecraftConnectTool.ViewModels.RightPage"
             xmlns:icons="using:Material.Icons.Avalonia"
             x:Class="MinecraftConnectTool.Views.RightPage.PanelThanks"
             x:DataType="vm:PanelThanksViewModel"
             Width="380">
  <UserControl.Styles>
    <Style Selector="Button.back-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.back-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceVariantBrush}"/>
    </Style>
    <Style Selector="Button.refresh-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="8"/>
      <Setter Property="Width" Value="36"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.refresh-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceVariantBrush}"/>
    </Style>
    <Style Selector="Button.github-button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="6"/>
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.github-button:pointerover">
      <Setter Property="Background" Value="{DynamicResource MaterialSurfaceVariantBrush}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <Grid Grid.Row="0" Height="48" ColumnDefinitions="Auto,*,Auto" Margin="0">
      <Button Grid.Column="0"
              x:Name="BackButton"
              Classes="back-button"
              VerticalAlignment="Center"
              Margin="8,0,0,0">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <icons:MaterialIcon Kind="ArrowLeft" Width="16" Height="16" Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
          <TextBlock Text="Back" FontSize="14" Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
        </StackPanel>
      </Button>

      <StackPanel Grid.Column="1"
                  Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center"
                  Margin="12,0,0,0">
        <icons:MaterialIcon Kind="HeartOutline"
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource MaterialPrimaryBrush}"/>
        <TextBlock x:Name="TitleText"
                   Text="贡献者与鸣谢"
                   FontSize="14"
                   VerticalAlignment="Center"
                   FontWeight="Medium"
                   Foreground="{DynamicResource MaterialOnSurfaceBrush}"/>
      </StackPanel>

      <Button Grid.Column="2"
              x:Name="RefreshButton"
              Classes="refresh-button"
              VerticalAlignment="Center"
              HorizontalAlignment="Right"
              Margin="0,0,8,0">
        <icons:MaterialIcon Kind="Refresh"
                            Width="20"
                            Height="20"
                            Foreground="{DynamicResource MaterialPrimaryBrush}"/>
      </Button>
    </Grid>

    <ScrollViewer Grid.Row="1" Margin="12,0,12,12">
      <StackPanel x:Name="ContributorsPanel" Spacing="8">
        <TextBlock x:Name="LoadingText"
                   Text="正在加载..."
                   FontSize="13"
                   Foreground="{DynamicResource MaterialOnSurfaceBrush}"
                   Opacity="0.6"
                   HorizontalAlignment="Center"
                   Margin="0,20,0,0"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>